# Variaveis do servidor (envio do formulario via SES/SMTP).
# Copie para .env.local e preencha. Nunca commite valores.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTATO_DE=
CONTATO_PARA=
# Opcional: hosts a mais aceitos como origem do formulario, separados por virgula
# (endereco provisorio antes da troca de DNS). Vazio = so hurryapp.dev e www.
CONTATO_HOSTS_EXTRA=
